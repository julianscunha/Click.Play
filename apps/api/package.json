{
  "name": "@clickplay/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check src"
  },
  "dependencies": {
    "@clickplay/domain": "workspace:*",
    "@clickplay/providers": "workspace:*",
    "@clickplay/video-engine": "workspace:*",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.2",
    "fastify": "^5.8.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "remotion": "4.0.441",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.4",
    "ffmpeg-static": "^5.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
