OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Opcional — se setado, usado automaticamente quando OPENROUTER_MODEL falhar
# (quota, erro, "No output generated").
OPENROUTER_MODEL_FALLBACK=

# Opcional — timeout (ms) por chamada de LLM. Default 90000 (90s). Suba esse
# valor se usa um alias-router (proxy sobre vários modelos) — a seleção entre
# modelos atrás do alias pode ultrapassar 90s mesmo funcionando normalmente,
# derrubando pro fallback sem necessidade.
LLM_TIMEOUT_MS=

# Opcional — modelo de imagem via OpenRouter (/v1/images). Vazio = default do código.
IMAGE_MODEL=

# Opcional — 2º modelo de imagem via OpenRouter, tentado antes do Gemini direto.
# Útil se o modelo primário bater rate limit sozinho (ex. variante ":free").
IMAGE_MODEL_FALLBACK=

# Opcional — modelo de vídeo via OpenRouter (/v1/videos). Vazio = default do código.
VIDEO_MODEL=

# Opcional — 2º modelo de vídeo via OpenRouter, tentado antes do Gemini direto.
VIDEO_MODEL_FALLBACK=

# Opcional — modelo usado como fallback do EdgeTTS via OpenRouter. Vazio = default do código.
TTS_MODEL_FALLBACK=

# Opcional — só necessário se TTS_MODEL_FALLBACK for um modelo custom (não
# Gemini) que exija voz explícita. Achado em teste manual real: um modelo
# fish-audio devolveu 400 "An explicit voice is required" sem esse campo.
# Nome da voz é específico do catálogo de cada modelo (ex. flux-bree-en).
TTS_MODEL_FALLBACK_VOICE=

# Opcional — 2º modelo de TTS via OpenRouter, tentado antes do Gemini TTS direto.
TTS_MODEL_FALLBACK_2=

# Opcional — mesmo papel de TTS_MODEL_FALLBACK_VOICE, mas pro modelo acima.
TTS_MODEL_FALLBACK_2_VOICE=

# "bundled" (default, grátis) ou "lyria" (IA generativa via OpenRouter, ainda não validada ao vivo — quota do provider bloqueada no teste).
MUSIC_PROVIDER=

# Opcional — só usado se MUSIC_PROVIDER=lyria. Vazio = default do código (google/lyria-3-pro-preview).
MUSIC_MODEL=

# Opcional — 2º modelo Lyria/OpenRouter, tentado antes de cair pras trilhas prontas.
MUSIC_MODEL_FALLBACK=

# Opcional — geração de imagem/vídeo já roda via OPENROUTER_API_KEY (endpoint
# /v1/images). Só necessária pra fallback do TTS (Edge falha às vezes com
# "Premature close") e pra Veo/GeminiImage direto se OpenRouter falhar.
GOOGLE_API_KEY=

# Opcional — segundo provider de vídeo (fal.ai, ex: Kling), usado como
# fallback quando "auto" e o provider resolvido falhar.
FAL_API_KEY=

# Opcionais — stock footage/imagem como alternativa à geração por IA
# (packages/providers/src/stock/{pexels,pixabay}.ts). Sem chave, provider correspondente não entra.
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Opcionais — publicação direta no YouTube (packages/providers/src/publish).
# Credencial OAuth "App da Web" no Google Cloud Console, com a YouTube Data API v3
# habilitada e http://localhost:8787/oauth/youtube/callback como redirect URI
# autorizado. YOUTUBE_REFRESH_TOKEN não é preenchido à mão — é gravado
# automaticamente ao clicar "Conectar com Google" em Configurações → Publicação.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

DATABASE_URL=

# Onde os jobs gravam assets/áudio/output (job.runDir). Vazio = ./data/runs.
RUNS_DIR=

PORT=8787

# Se preenchido, toda rota (exceto /health e /files/*) exige
# "Authorization: Bearer <API_TOKEN>". Vazio = sem autenticação (só localhost).
API_TOKEN=

# Nível de log do Fastify/pino (trace|debug|info|warn|error|fatal). Default: info.
LOG_LEVEL=
